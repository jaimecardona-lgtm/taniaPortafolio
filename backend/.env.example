# Copia este archivo a backend/.env para desarrollo local (docker compose o uvicorn).
# No subas backend/.env al repositorio. En Render la API key va en el dashboard.

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Opcional. Vacío = RENDER_EXTERNAL_URL (en Render) o http://localhost:10000 (local)
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Tania Peláez Valverde Portfolio

# Chat LLM Configuration
CHAT_PRIMARY_LLM=nvidia/nemotron-3.5-lightning:free
CHAT_FALLBACK_LLM=openrouter/free
CHAT_USE_FALLBACK=true

# Chat Parameters
CHAT_TEMPERATURE=0.2
CHAT_TOP_P=0.8
CHAT_MAX_TOKENS=450
CHAT_TIMEOUT_MS=45000

# CORS: solo importa con frontend separado (Docker y Render son same-origin)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:10000
