# Nginx: único proceso público del contenedor.
# __PORT__ lo sustituye deploy/start.sh con la variable PORT (Render la inyecta).

server {
    listen __PORT__;
    server_name _;

    root /app/frontend-dist;
    index index.html;

    server_tokens off;

    gzip on;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Assets con hash generados por Vite: cache larga
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Videos servidos directamente por Nginx (HTTP Range -> 206 Partial Content).
    # try_files con =404 evita que un video inexistente devuelva index.html.
    location ~* \.(mp4|webm|mov)$ {
        expires 7d;
        try_files $uri =404;
    }

    # Backend FastAPI (interno, solo escucha en 127.0.0.1:8000)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }

    # index.html sin cache para que los despliegues se vean de inmediato
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Rutas de React Router (/, /empresa, /experiencia, /portafolio) -> SPA.
    # Sin $uri/: public/ tiene carpetas /experiencia y /portafolio que de otro modo
    # provocarían un 301 en lugar de servir la SPA.
    location / {
        try_files $uri /index.html;
    }
}
